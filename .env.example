# FactLoom Environment Configuration
# Copy this file to .env and configure your keys

# Groq API Key for LLM extraction, canonicalization, and adjudication
# Sign up at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Database path (defaults to factloom.db in project root)
FACTLOOM_DB_PATH=factloom.db

# Storage directory for document uploads
FACTLOOM_UPLOAD_DIR=uploads
